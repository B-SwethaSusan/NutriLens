ENVIRONMENT=development
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Local Docker compose uses its pgvector database automatically.
# For Supabase PostgreSQL, replace DATABASE_URL and fill SUPABASE_* values.
#DATABASE_URL=postgresql+psycopg://nutrition:nutrition_dev_password@localhost:5432/nutrition_rag
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=nutrition-pdfs

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1
GEMINI_API_KEY=
# Which AI provider answers chat/diet plans: gemini or mistral
LLM_PROVIDER=gemini
EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_DIMENSIONS=768

CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
TEMPERATURE=0.2
MAX_UPLOAD_SIZE_MB=100
RATE_LIMIT_PER_MINUTE=60
REDIS_URL=
